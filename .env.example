# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Browser client
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=300

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PREDICTION_TOPIC=prediction-events
KAFKA_RESULT_TOPIC=prediction-results
KAFKA_DEAD_LETTER_TOPIC=prediction-events-dlq
KAFKA_CONSUMER_GROUP=streampredict-consumers

# Model serving
TORCHSERVE_INFERENCE_URL=http://localhost:8080/predictions/streampredict-demo
MODEL_NAME=streampredict-demo
MODEL_VERSION=development

# MLflow and S3-compatible artifact storage
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
S3_MODEL_BUCKET=streampredict-models

# Demo safety limits
DEMO_MAX_RPS=100
DEMO_MAX_DURATION_SECONDS=300
DEMO_MAX_CONCURRENT_SESSIONS=1

