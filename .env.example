# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://localhost:3000
API_MAX_IN_FLIGHT_PREDICTIONS=256
METRICS_STREAM_INTERVAL_SECONDS=1
METRICS_STREAM_MAX_SECONDS=300

# Browser client
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=300
REDIS_TIMEOUT_SECONDS=0.05
REDIS_CIRCUIT_OPEN_SECONDS=5

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PREDICTION_TOPIC=prediction-events
KAFKA_RESULT_TOPIC=prediction-results
KAFKA_DEAD_LETTER_TOPIC=prediction-events-dlq
KAFKA_CONSUMER_GROUP=streampredict-consumers
KAFKA_PUBLISH_TIMEOUT_SECONDS=2
KAFKA_RECONNECT_INTERVAL_SECONDS=5

# Consumer workers
CONSUMER_BATCH_SIZE=200
CONSUMER_CONCURRENCY=32
CONSUMER_MAX_ATTEMPTS=3
CONSUMER_RETRY_BACKOFF_SECONDS=0.2
CONSUMER_IDEMPOTENCY_TTL_SECONDS=86400
CONSUMER_METRICS_PORT=9102

# Model serving: `serving` calls the ONNX Runtime service; `mock` scores in-process.
INFERENCE_BACKEND=mock
SERVING_URL=http://localhost:8001
MODEL_NAME=streampredict-demo
# With INFERENCE_BACKEND=serving, `latest` pins the highest version available at startup.
MODEL_VERSION=development
INFERENCE_TIMEOUT_SECONDS=1
MOCK_INFERENCE_LATENCY_MS=15

# MLflow and S3-compatible artifact storage
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
S3_MODEL_BUCKET=streampredict-models

# Demo safety limits
DEMO_MAX_RPS=100
DEMO_MAX_DURATION_SECONDS=300
DEMO_MAX_CONCURRENT_SESSIONS=1
# When set, demo control endpoints require a matching X-Demo-Token header.
DEMO_CONTROL_TOKEN=

